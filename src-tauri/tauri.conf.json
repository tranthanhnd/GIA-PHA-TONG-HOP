{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gia Phả Việt - Bản Tổng Hợp",
  "version": "48.0.0",
  "identifier": "vn.tthoanggiaroyal.giaphaviet.tonghop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Gia Phả Việt - Bản Tổng Hợp",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}